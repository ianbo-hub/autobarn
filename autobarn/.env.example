# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose

# ─── Sanity CMS ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your-write-token                 # server-side only

# ─── Cloudinary ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Algolia ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-search-only-key   # safe to expose
ALGOLIA_ADMIN_KEY=your-admin-key                       # server-side only

# ─── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=bookings@autobarn.co.ke

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://autobarn.co.ke
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-maps-key

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
